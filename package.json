{
  "name": "dsh-conversation-rail",
  "version": "0.1.1",
  "description": "Session minimap for DSH Web: one bar per turn along the left edge of the conversation, hover for a question/answer preview, click to jump. · 会话小地图：一根杠一轮对话，悬停出提问+回答预览，点击跳转。",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "author": "dingyi580",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingyi580/dsh-conversation-rail.git"
  },
  "homepage": "https://github.com/dingyi580/dsh-conversation-rail#readme",
  "bugs": {
    "url": "https://github.com/dingyi580/dsh-conversation-rail/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "conversation",
    "minimap",
    "navigation",
    "outline",
    "session"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsdown",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.host.json --noEmit"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
