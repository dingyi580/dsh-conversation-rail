{
  "name": "@dsh-external/dsh-conversation-rail",
  "version": "0.0.1",
  "description": "会话小地图：对话左缘一条竖轨，一根杠一轮对话，悬停出提问+回答预览，点击跳转",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsdown",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.host.json --noEmit"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
